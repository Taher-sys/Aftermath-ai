# AFTERMATH Environment Configuration Template

# ============================================================================
# Database Configuration (PostgreSQL 16+)
# ============================================================================
POSTGRES_USER=aftermath
POSTGRES_PASSWORD=aftermath_dev_secret
POSTGRES_DB=aftermath
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aftermath:aftermath_dev_secret@localhost:5432/aftermath

# ============================================================================
# Cache & Task Queue (Redis 7)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# Backend API Configuration
# ============================================================================
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_V1_PREFIX=/api/v1
SECRET_KEY=change_this_to_a_random_secure_hex_key_in_production

# ============================================================================
# Storage Vault (Local or S3)
# ============================================================================
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/vault

# ============================================================================
# Frontend Configuration
# ============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NODE_ENV=development
